@using System.Text.Json
@model DeliveryManagement.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">
    <h2 class="fw-bold mb-4">Tổng quan vận hành</h2>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-secondary">Tổng đơn hàng</p>
                    <h3>@Model.TotalOrders.ToString("N0")</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-secondary">Đang giao</p>
                    <h3>@Model.DeliveringOrders.ToString("N0")</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-secondary">Đã giao</p>
                    <h3>@Model.DeliveredOrders.ToString("N0")</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-secondary">COD đã thu</p>
                    <h3>@Model.CodCollected.ToString("N0") ₫</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5>Đơn hàng trong 7 ngày</h5>
                    <div style="height:320px">
                        <canvas id="ordersChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5>Phân bố trạng thái</h5>
                    <div style="height:320px">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(
                    JsonSerializer.Serialize(Model.ChartLabels));
    const counts = @Html.Raw(
                JsonSerializer.Serialize(Model.ChartOrderCounts));
    const statusLabels = @Html.Raw(
                JsonSerializer.Serialize(Model.StatusLabels));
    const statusCounts = @Html.Raw(
                JsonSerializer.Serialize(Model.StatusCounts));

    new Chart(document.getElementById('ordersChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Số đơn',
                data: counts,
                backgroundColor: '#2563eb'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });

        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusCounts,
                    backgroundColor: [
                        '#f59e0b', '#0d6efd', '#16a34a',
                        '#dc2626', '#64748b', '#7c3aed'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
}