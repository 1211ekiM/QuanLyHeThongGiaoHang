<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Delivery Management</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold"
               asp-controller="Dashboard" asp-action="Index">
                Delivery Management
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Admin") ||
                                        User.IsInRole("Receptionist"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Orders" asp-action="Index">
                                Đơn hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Customers" asp-action="Index">
                                Khách hàng
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Reports" asp-action="Index">
                                Báo cáo
                            </a>
                        </li>
                    }
                </ul>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="navbar-text">
                            @User.Identity.Name
                        </span>

                        <form action="/Account/Logout"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-light">
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </nav>

    <main class="container-fluid">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>